{
  "name": "@sudobility/music_sample_engine",
  "version": "0.0.2",
  "description": "MP3 sample-based FluidR3 playback engine for ScoreSmith on React Native — the fallback when no native synth is available",
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "react-native": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./expression-table": {
      "types": "./dist/playback/expression-table.d.ts",
      "import": "./dist/playback/expression-table.js",
      "default": "./dist/playback/expression-table.js"
    }
  },
  "files": [
    "dist",
    "CLAUDE.md"
  ],
  "keywords": [
    "scoresmith",
    "music",
    "playback",
    "soundfont",
    "samples",
    "react-native"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && node scripts/fix-esm-imports.mjs",
    "clean": "rimraf dist",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "verify": "bun run format:check && bun run typecheck && bun run lint && bun run test:unit && bun run build",
    "prepublishOnly": "bun run clean && bun run verify"
  },
  "peerDependencies": {
    "@sudobility/music_player": "^0.1.82",
    "@sudobility/music_types": "^0.13.62",
    "react-native-audio-api": ">=0.13.0"
  },
  "peerDependenciesMeta": {
    "react-native-audio-api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@sudobility/music_player": "^0.1.82",
    "@sudobility/music_types": "^0.13.62",
    "@types/node": "~26.6.5",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~10.13.0",
    "globals": "~17.13.0",
    "prettier": "~3.9.10",
    "rimraf": "~6.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.0",
    "vitest": "~4.1.12"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/music_sample_engine.git"
  },
  "dependencies": {}
}
